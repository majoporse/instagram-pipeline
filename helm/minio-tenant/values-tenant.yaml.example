# MinIO Tenant config for the official MinIO Operator chart.
#
#   helm repo add minio-operator https://operator.min.io
#   helm install minio minio-operator/tenant -n media --create-namespace \
#     -f helm/minio-tenant/values-tenant.yaml
#
# Prerequisite: the MinIO Operator (see README.md). The operator is frozen
# (archived Mar 2026), so the image tags below won't move.

tenant:
  name: minio
  image:
    repository: minio/minio
    # Frozen MinIO CE image; pin a digest for immutability if you prefer.
    tag: latest
    pullPolicy: IfNotPresent

  # Root S3 credentials. CHANGE secretKey -- these are the S3 access/secret keys
  # the app uses (uploader/storage.py). The operator mounts this as config.env.
  configSecret:
    name: minio-credentials
    accessKey: admin
    secretKey: ""

  # Standalone: one server, no replicas. The operator expects >=4 volumes per
  # pool, so 4 small PVCs on one node.
  pools:
    - name: pool-0
      servers: 1
      volumesPerServer: 4
      size: 5Gi
      storageClassName: local-path

  # TLS is terminated at the ingress (Traefik + cert-manager); MinIO stays HTTP.
  certificate:
    requestAutoCert: false

  buckets:
    - name: instagram-pipeline

  # Tell the console its external URL so redirects behind the ingress work.
  env:
    - name: MINIO_BROWSER_REDIRECT_URL
      value: "https://minio-console.pipeline.hatal.cc"

# Public S3 API + web console. Both terminate TLS at Traefik.
ingress:
  api:
    enabled: true
    ingressClassName: traefik
    host: s3.mydomain.com
    path: /
    pathType: Prefix
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod
    tls:
      - secretName: minio-tls
        hosts:
          - s3.mydomain.com
  console:
    enabled: true
    ingressClassName: traefik
    host: minio-console.mydomain.com
    path: /
    pathType: Prefix
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod
    tls:
      - secretName: minio-console-tls
        hosts:
          - minio-console.mydomain.com
